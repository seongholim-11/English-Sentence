# 음성 생성 스크립트(npm run audio) 전용 설정입니다. 앱에는 포함되지 않습니다.
# 이 파일을 복사해 .env로 만들고 값을 채우세요 (.env는 커밋되지 않습니다).
# 키 파일은 쓰지 않습니다. `gcloud auth application-default login` 으로 인증하세요.
#
# 주의: 이름에 EXPO_PUBLIC_ 을 붙이지 마세요. 붙이면 앱 번들에 값이 들어갑니다.

# 결제가 연결되고 Text-to-Speech API가 켜진 Google Cloud 프로젝트 ID
GOOGLE_CLOUD_PROJECT=

# 음성 이름. `npm run audio -- --list-voices` 로 목록을 확인하세요
TTS_VOICE=en-US-Chirp3-HD-Aoede

# 대화문에서 "나"(B)가 말하는 문장의 음성
TTS_VOICE_ALT=en-US-Chirp3-HD-Charon

# 한 번에 새로 만들 글자 수 상한 (월 무료 한도 100만 자보다 한참 낮게)
TTS_CHAR_LIMIT=200000

# gcloud 실행 파일 경로 (PATH에 없을 때)
GCLOUD_PATH=C:\Program Files (x86)\Google\Cloud SDK\google-cloud-sdk\bin\gcloud.cmd
